@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

# @see docs/native-hold.md
<urn:oxidal:plugin:hold#mono> a lv2:Plugin, lv2:SpectralPlugin ;
    doap:name "Oxidal Hold (Mono)" ; doap:license <https://opensource.org/licenses/MIT> ;
    rdfs:comment "Hold captures what you are playing and keeps it ringing as a seamless drone while you play over it. Attack and Release fade it in and out; Level sets it against the dry signal; Dry off leaves only the held sound." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "hold" ; lv2:name "Hold" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "attack" ; lv2:name "Attack" ; lv2:minimum 10 ; lv2:maximum 5000 ; lv2:default 300 ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "release" ; lv2:name "Release" ; lv2:minimum 10 ; lv2:maximum 10000 ; lv2:default 1500 ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:minimum -40 ; lv2:maximum 6 ; lv2:default 0 ; units:unit units:db ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "dry" ; lv2:name "Dry" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 1 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 5 ; lv2:symbol "in_l" ; lv2:name "Input" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 6 ; lv2:symbol "out_l" ; lv2:name "Output" ] .

<urn:oxidal:plugin:hold#stereo> a lv2:Plugin, lv2:SpectralPlugin ;
    doap:name "Oxidal Hold (Stereo)" ; doap:license <https://opensource.org/licenses/MIT> ;
    rdfs:comment "Stereo Hold: each side is held on its own, with independent phases for a wide drone." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "hold" ; lv2:name "Hold" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "attack" ; lv2:name "Attack" ; lv2:minimum 10 ; lv2:maximum 5000 ; lv2:default 300 ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "release" ; lv2:name "Release" ; lv2:minimum 10 ; lv2:maximum 10000 ; lv2:default 1500 ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:minimum -40 ; lv2:maximum 6 ; lv2:default 0 ; units:unit units:db ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "dry" ; lv2:name "Dry" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 1 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 5 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 6 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 7 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 8 ; lv2:symbol "out_r" ; lv2:name "Output R" ] .
