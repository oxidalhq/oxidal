+
+  // An armed oversampled IR needs independent filter history for its dry
+  // endpoint. The block's ordinary Mix still uses the unfiltered input.
+  struct SceneIrDry {
+    SceneIrDry(int factor, int baseFrames)
+        : frames(static_cast<size_t>(factor) * static_cast<size_t>(baseFrames)),
+          samples(std::make_unique<float[]>(2 * frames)) {
+      island.prepare(factor, baseFrames);
+    }
+
+    static size_t requiredBytes(int factor, int baseFrames) noexcept {
+      const auto frames = static_cast<size_t>(factor) * static_cast<size_t>(baseFrames);
+      return sizeof(SceneIrDry) + frames * 2 * sizeof(float)
+          + ChainOversampler::requiredWorkBytes(frames);
+    }
+
+    size_t allocatedBytes() const noexcept {
+      return sizeof(SceneIrDry) + frames * 2 * sizeof(float) + island.allocatedWorkBytes();
+    }
+
+    void filter(const juce::AudioBuffer<float>& input, int channels, int count) noexcept {
+      float* pointers[2]{samples.get(), samples.get() + frames};
+      for (int ch = 0; ch < channels; ++ch)
+        std::copy_n(input.getReadPointer(ch), count, pointers[ch]);
+      island.processBaseRateIsland(pointers, channels, count, [](float* const*, int) {});
+    }
+
+    size_t frames;
+    std::unique_ptr<float[]> samples;
+    ChainOversampler island;
+  };
