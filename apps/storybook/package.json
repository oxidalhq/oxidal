{
  "name": "@oxidal/storybook",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build": "tsc --noEmit && storybook build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:stories": "node scripts/check-story-interactions.mjs && vitest run",
    "check": "pnpm --dir ../../packages/ui check && pnpm format:check && pnpm lint && pnpm test:stories && pnpm build && pnpm layout",
    "layout": "node scripts/layout.mjs"
  },
  "dependencies": {
    "@oxidal/design-system": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
