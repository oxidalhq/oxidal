        "name": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "staged": {
          "type": "boolean"
        },
        "step": {
          "type": "number",
          "format": "double"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
