{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "description": "Schema generation root. Rust wire types are the contract source of truth.\n@see docs/architecture.md",
  "type": "object",
  "properties": {
    "audio_command": {
      "$ref": "#/$defs/AudioCommand"
    },
    "audio_devices": {
      "$ref": "#/$defs/AudioDevices"
    },
    "audio_probe": {
      "$ref": "#/$defs/AudioProbe"
    },
    "audio_probe_result": {
      "$ref": "#/$defs/AudioProbeResult"
    },
    "audio_state": {
      "$ref": "#/$defs/AudioState"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "command": {
      "$ref": "#/$defs/Command"
    },
    "error": {
      "$ref": "#/$defs/ApiError"
    },
    "library": {
      "$ref": "#/$defs/Library"
    },
    "native_command": {
      "$ref": "#/$defs/EditorCommand"
    },
    "native_editor": {
      "$ref": "#/$defs/EditorSnapshot"
    },
    "preset": {
      "$ref": "#/$defs/Inspection"
    },
    "rig": {
      "$ref": "#/$defs/Rig"
    },
    "snapshot": {
      "$ref": "#/$defs/Snapshot"
    },
    "validation": {
      "$ref": "#/$defs/Validation"
    }
  },
  "required": [
    "snapshot",
    "command",
    "rig",
    "validation",
    "capabilities",
    "audio_state",
    "audio_command",
    "audio_devices",
    "audio_probe",
    "audio_probe_result",
    "error",
    "library",
    "preset",
    "native_editor",
    "native_command"
  ],
  "$defs": {
    "Action": {
      "description": "One command entry point; relative edits are applied to current authoritative state.\n@see docs/architecture.md",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "set"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delta": {
              "type": "number",
              "format": "double"
            },
            "target": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "adjust"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rig": {
              "$ref": "#/$defs/Rig"
            },
            "type": {
              "type": "string",
              "const": "routing"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "rig"
          ]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "$ref": "#/$defs/MappingFile"
            },
            "type": {
              "type": "string",
              "const": "mappings"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/MidiInput"
            },
            "type": {
              "type": "string",
              "const": "midi"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "edit": {
              "$ref": "#/$defs/Edit"
            },
            "type": {
              "type": "string",
              "const": "edit"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "edit"
          ]
        }
      ]
    },
    "ActionDescriptor": {
      "description": "Enumerated commands are discoverable alongside numeric parameters.\n@see docs/architecture.md",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
