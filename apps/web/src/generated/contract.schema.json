          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "direction"
      ]
    },
    "AudioPhase": {
      "type": "string",
      "enum": [
        "unavailable",
        "stopped",
        "starting",
        "running",
        "stopping",
        "failed"
