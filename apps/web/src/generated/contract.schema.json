    },
    "AudioProbe": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "endpoint": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/SampleFormat"
        },
        "period_frames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "periods": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sample_rate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
