[Unit]
Description=Oxidal unprivileged interactive terminal
After=local-fs.target
StartLimitIntervalSec=0

[Service]
User=oxidal-debug
Group=oxidal-control
RuntimeDirectory=oxidal-terminal
RuntimeDirectoryMode=0750
WorkingDirectory=/run/oxidal-terminal
ExecStart=/opt/oxidal/bin/oxidal-terminal-service unprivileged
Restart=always
RestartSec=0.2
KillMode=control-group
TimeoutStopSec=2
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
