@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

# @see docs/native-echo.md
<urn:oxidal:plugin:echo#mono> a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "Oxidal Echo (Mono)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:comment "Echo is eight kinds of delay behind one Mode control: Digital (clean), Tape (one sliding head with wow, flutter and wear), Heads (four heads on one loop), Bucket (bucket-brigade: darker as it gets longer, companded, a little noisy), Reverse (repeats play backwards), Duck (repeats drop while you play), Filter (a resonant sweep on the repeats) and Ping (as Digital in mono). Time sets the delay in milliseconds, or with Sync on, BPM and Division set it as a note value. Feedback is the number of repeats and goes a little past endless; Tone runs from dark through open to thin; Mod is wow and flutter, the Duck amount, the Filter depth or a gentle chorus; Age is tape wear and bucket noise; Heads and Spacing choose and place the heads in Heads mode; Mix runs from dry to repeats only and lets the tail ring out when turned down; Hold loops what is in the memory. Up to 4 s. No latency." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "mode" ; lv2:name "Mode" ; lv2:minimum 0 ; lv2:maximum 7 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Digital" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Tape" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Heads" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "Bucket" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "Reverse" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "Duck" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "Filter" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "Ping" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "time" ; lv2:name "Time" ; lv2:minimum 20 ; lv2:maximum 4000 ; lv2:default 380 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "sync" ; lv2:name "Sync" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "bpm" ; lv2:name "BPM" ; lv2:minimum 40 ; lv2:maximum 240 ; lv2:default 120 ; units:unit units:bpm ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "division" ; lv2:name "Division" ; lv2:minimum 0 ; lv2:maximum 9 ; lv2:default 4 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/1" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "1/2 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "1/2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "1/4 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "1/4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "1/8 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "1/4 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "1/8" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "1/8 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ], [ rdfs:label "1/16" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 9 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:minimum 0 ; lv2:maximum 110 ; lv2:default 35 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "mod" ; lv2:name "Mod" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 20 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "age" ; lv2:name "Age" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 30 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "heads" ; lv2:name "Heads" ; lv2:minimum 0 ; lv2:maximum 14 ; lv2:default 14 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "1+2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "1+3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "1+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "2+3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "2+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ], [ rdfs:label "3+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 9 ], [ rdfs:label "1+2+3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 10 ], [ rdfs:label "1+2+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 11 ], [ rdfs:label "1+3+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 12 ], [ rdfs:label "2+3+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 13 ], [ rdfs:label "All" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 14 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "spacing" ; lv2:name "Spacing" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 0 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "width" ; lv2:name "Width" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 20 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "hold" ; lv2:name "Hold" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 14 ; lv2:symbol "in_l" ; lv2:name "Input" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 15 ; lv2:symbol "out_l" ; lv2:name "Output" ] .

<urn:oxidal:plugin:echo#stereo> a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "Oxidal Echo (Stereo)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:comment "Stereo Echo: each side has its own delay memory. Width spreads the repeats, from mono at 0 to wide at 100: the right repeat trails the left by a few milliseconds, modulation runs out of step, heads sit across the image, and in Ping the repeats alternate left and right. All other controls work as in the mono plugin. No latency." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "mode" ; lv2:name "Mode" ; lv2:minimum 0 ; lv2:maximum 7 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Digital" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Tape" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Heads" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "Bucket" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "Reverse" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "Duck" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "Filter" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "Ping" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "time" ; lv2:name "Time" ; lv2:minimum 20 ; lv2:maximum 4000 ; lv2:default 380 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "sync" ; lv2:name "Sync" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "bpm" ; lv2:name "BPM" ; lv2:minimum 40 ; lv2:maximum 240 ; lv2:default 120 ; units:unit units:bpm ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "division" ; lv2:name "Division" ; lv2:minimum 0 ; lv2:maximum 9 ; lv2:default 4 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/1" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "1/2 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "1/2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "1/4 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "1/4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "1/8 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "1/4 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "1/8" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "1/8 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ], [ rdfs:label "1/16" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 9 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:minimum 0 ; lv2:maximum 110 ; lv2:default 35 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "mod" ; lv2:name "Mod" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 20 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "age" ; lv2:name "Age" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 30 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "heads" ; lv2:name "Heads" ; lv2:minimum 0 ; lv2:maximum 14 ; lv2:default 14 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "1+2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "1+3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "1+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "2+3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "2+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ], [ rdfs:label "3+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 9 ], [ rdfs:label "1+2+3" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 10 ], [ rdfs:label "1+2+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 11 ], [ rdfs:label "1+3+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 12 ], [ rdfs:label "2+3+4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 13 ], [ rdfs:label "All" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 14 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "spacing" ; lv2:name "Spacing" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 0 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "width" ; lv2:name "Width" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 20 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "hold" ; lv2:name "Hold" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 14 ; lv2:symbol "in_l" ; lv2:name "Input left" ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 15 ; lv2:symbol "in_r" ; lv2:name "Input right" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 16 ; lv2:symbol "out_l" ; lv2:name "Output left" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 17 ; lv2:symbol "out_r" ; lv2:name "Output right" ] .
