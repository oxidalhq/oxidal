@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

# @see docs/native-motion.md
<urn:oxidal:plugin:motion#mono> a lv2:Plugin, lv2:ModulatorPlugin ;
    doap:name "Oxidal Motion (Mono)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:comment "Motion is nine modulation effects behind one Mode control: Chorus, Flanger, Phaser, Vibe, Rotary speaker, Tremolo, Harmonic tremolo, Vibrato and Ring modulation. Rate sets the speed, or Sync locks it to Tempo and Division; in Ring it tunes the carrier from 20 Hz to 2 kHz, and in Rotary it is the slow speed, which Fast multiplies by eight with the horn and drum gathering speed at their own pace. Depth sets how far the effect moves; Feedback sharpens Flanger, Phaser and Vibe; Tone brightens the effect or moves its centre; Shape picks one of three variants of each mode. Mix at 0 is the untouched signal; Chorus, Flanger A, Phaser and Vibe blend up to the effect alone at 100, the other modes are fully on from 50. Changing Mode crossfades. No latency." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "mode" ; lv2:name "Mode" ; lv2:minimum 0 ; lv2:maximum 8 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Chorus" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Flanger" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Phaser" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "Vibe" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "Rotary" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "Tremolo" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "Harmonic" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "Vibrato" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "Ring" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "rate" ; lv2:name "Rate" ; lv2:minimum 0.05 ; lv2:maximum 12 ; lv2:default 0.8 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:hz ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "sync" ; lv2:name "Sync to tempo" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "bpm" ; lv2:name "Tempo" ; lv2:minimum 40 ; lv2:maximum 240 ; lv2:default 120 ; units:unit units:bpm ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "division" ; lv2:name "Division" ; lv2:minimum 0 ; lv2:maximum 11 ; lv2:default 5 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "4 bars" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "2 bars" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "1 bar" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "1/2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "1/4 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "1/4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "1/8 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "1/4 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "1/8" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ], [ rdfs:label "1/8 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 9 ], [ rdfs:label "1/16" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 10 ], [ rdfs:label "1/16 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 11 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "depth" ; lv2:name "Depth" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:minimum -100 ; lv2:maximum 100 ; lv2:default 0 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "shape" ; lv2:name "Shape" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "A" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "B" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "C" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "stereo" ; lv2:name "Stereo" ; lv2:minimum 0 ; lv2:maximum 180 ; lv2:default 90 ; units:unit units:degree ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "fast" ; lv2:name "Fast" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 12 ; lv2:symbol "in_l" ; lv2:name "Input" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 13 ; lv2:symbol "out_l" ; lv2:name "Output" ] .

<urn:oxidal:plugin:motion#stereo> a lv2:Plugin, lv2:ModulatorPlugin ;
    doap:name "Oxidal Motion (Stereo)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:comment "Stereo Motion: the nine modulation effects of the mono plugin with one oscillator for each side. Stereo sets how far apart the two sides move, from together (0) to opposite (180 degrees), which gives width even from a mono input; in Rotary it is the angle between two microphones around one cabinet. Every other control works as in the mono plugin. No latency." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "mode" ; lv2:name "Mode" ; lv2:minimum 0 ; lv2:maximum 8 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Chorus" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Flanger" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Phaser" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "Vibe" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "Rotary" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "Tremolo" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "Harmonic" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "Vibrato" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "Ring" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "rate" ; lv2:name "Rate" ; lv2:minimum 0.05 ; lv2:maximum 12 ; lv2:default 0.8 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:hz ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "sync" ; lv2:name "Sync to tempo" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "bpm" ; lv2:name "Tempo" ; lv2:minimum 40 ; lv2:maximum 240 ; lv2:default 120 ; units:unit units:bpm ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "division" ; lv2:name "Division" ; lv2:minimum 0 ; lv2:maximum 11 ; lv2:default 5 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "4 bars" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "2 bars" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "1 bar" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "1/2" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "1/4 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "1/4" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "1/8 dotted" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "1/4 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ], [ rdfs:label "1/8" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 8 ], [ rdfs:label "1/8 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 9 ], [ rdfs:label "1/16" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 10 ], [ rdfs:label "1/16 triplet" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 11 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "depth" ; lv2:name "Depth" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:minimum -100 ; lv2:maximum 100 ; lv2:default 0 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "shape" ; lv2:name "Shape" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "A" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "B" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "C" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "stereo" ; lv2:name "Stereo" ; lv2:minimum 0 ; lv2:maximum 180 ; lv2:default 90 ; units:unit units:degree ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "fast" ; lv2:name "Fast" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 12 ; lv2:symbol "in_l" ; lv2:name "Input left" ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 13 ; lv2:symbol "in_r" ; lv2:name "Input right" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 14 ; lv2:symbol "out_l" ; lv2:name "Output left" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 15 ; lv2:symbol "out_r" ; lv2:name "Output right" ] .
