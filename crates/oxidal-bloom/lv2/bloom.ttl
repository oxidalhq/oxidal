@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

# Control ports match CONTROLS in src/lib.rs; a test compares the two. @see docs/native-bloom.md
<urn:oxidal:plugin:bloom#mono> a lv2:Plugin, lv2:ReverbPlugin ;
    doap:name "Oxidal Bloom (Mono)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:comment "Bloom is a reverb with eight voices behind the Mode control: Room, Hall, Plate, Spring, Cloud (a huge slow wash), Bloom (a tail that swells after the note), Shimmer (an octave or fifth rising in the tail) and Nonlinear (gated, reverse and swell shapes). Decay is the length of the tail in seconds; Pre-delay holds the reverb back behind the note; Size sets how big the space is; Tone darkens the tail; Low cut keeps bass out of it; Mod and Mod speed add slow movement. Shimmer and Shimmer interval work in Shimmer, Shape in Nonlinear, Build in Bloom. Mix blends the reverb in and leaves the tail ringing when turned down; Freeze holds the tail for as long as it is on. No latency." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "mode" ; lv2:name "Mode" ; lv2:minimum 0 ; lv2:maximum 7 ; lv2:default 1 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Room" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Hall" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Plate" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "Spring" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "Cloud" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "Bloom" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "Shimmer" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "Nonlinear" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "decay" ; lv2:name "Decay" ; lv2:minimum 0.1 ; lv2:maximum 60 ; lv2:default 2.5 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:s ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "predelay" ; lv2:name "Pre-delay" ; lv2:minimum 0 ; lv2:maximum 250 ; lv2:default 10 ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "size" ; lv2:name "Size" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 60 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "lowcut" ; lv2:name "Low cut" ; lv2:minimum 20 ; lv2:maximum 1000 ; lv2:default 100 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:hz ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "mod" ; lv2:name "Mod" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 30 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "speed" ; lv2:name "Mod speed" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "shimmer" ; lv2:name "Shimmer" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "interval" ; lv2:name "Shimmer interval" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Octave up" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Fifth up" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Octave down" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "shape" ; lv2:name "Shape" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Gate" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Reverse" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Swell" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "build" ; lv2:name "Build" ; lv2:minimum 0.1 ; lv2:maximum 5 ; lv2:default 1 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:s ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 30 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "freeze" ; lv2:name "Freeze" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 14 ; lv2:symbol "in_l" ; lv2:name "Input" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 15 ; lv2:symbol "out_l" ; lv2:name "Output" ] .

<urn:oxidal:plugin:bloom#stereo> a lv2:Plugin, lv2:ReverbPlugin ;
    doap:name "Oxidal Bloom (Stereo)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:comment "Stereo Bloom: the reverb spreads a mono or stereo input into a wide stereo field. Mode, Decay, Pre-delay, Size, Tone, Low cut, Mod, Mod speed, Shimmer, Shimmer interval, Shape, Build, Mix and Freeze work as in the mono plugin. No latency." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "mode" ; lv2:name "Mode" ; lv2:minimum 0 ; lv2:maximum 7 ; lv2:default 1 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Room" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Hall" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Plate" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "Spring" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ], [ rdfs:label "Cloud" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4 ], [ rdfs:label "Bloom" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 5 ], [ rdfs:label "Shimmer" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 6 ], [ rdfs:label "Nonlinear" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 7 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "decay" ; lv2:name "Decay" ; lv2:minimum 0.1 ; lv2:maximum 60 ; lv2:default 2.5 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:s ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "predelay" ; lv2:name "Pre-delay" ; lv2:minimum 0 ; lv2:maximum 250 ; lv2:default 10 ; units:unit units:ms ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "size" ; lv2:name "Size" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 60 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "lowcut" ; lv2:name "Low cut" ; lv2:minimum 20 ; lv2:maximum 1000 ; lv2:default 100 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:hz ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "mod" ; lv2:name "Mod" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 30 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "speed" ; lv2:name "Mod speed" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "shimmer" ; lv2:name "Shimmer" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 50 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "interval" ; lv2:name "Shimmer interval" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Octave up" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Fifth up" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Octave down" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "shape" ; lv2:name "Shape" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Gate" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Reverse" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Swell" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "build" ; lv2:name "Build" ; lv2:minimum 0.1 ; lv2:maximum 5 ; lv2:default 1 ; lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ; units:unit units:s ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 30 ; units:unit units:pc ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "freeze" ; lv2:name "Freeze" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 14 ; lv2:symbol "in_l" ; lv2:name "Input left" ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 15 ; lv2:symbol "in_r" ; lv2:name "Input right" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 16 ; lv2:symbol "out_l" ; lv2:name "Output left" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 17 ; lv2:symbol "out_r" ; lv2:name "Output right" ] .
