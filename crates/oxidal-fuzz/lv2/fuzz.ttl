@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
<urn:oxidal:plugin:fuzz#mono> a lv2:Plugin, lv2:DistortionPlugin ; doap:name "Oxidal Fuzz (Mono)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ; lv2:optionalFeature lv2:hardRTCapable ; lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "drive" ; lv2:name "Drive" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 55 ; units:unit units:pc ], [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 55 ; units:unit units:pc ], [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 75 ; units:unit units:pc ], [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:minimum -24 ; lv2:maximum 6 ; lv2:default 0 ; units:unit units:db ], [ a lv2:InputPort, lv2:AudioPort ; lv2:index 4 ; lv2:symbol "in" ; lv2:name "Input" ], [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 5 ; lv2:symbol "out" ; lv2:name "Output" ] .
<urn:oxidal:plugin:fuzz#stereo> a lv2:Plugin, lv2:DistortionPlugin ; doap:name "Oxidal Fuzz (Stereo)" ; doap:license <https://www.apache.org/licenses/LICENSE-2.0> ; lv2:optionalFeature lv2:hardRTCapable ; lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "drive" ; lv2:name "Drive" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 55 ; units:unit units:pc ], [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 55 ; units:unit units:pc ], [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 75 ; units:unit units:pc ], [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:minimum -24 ; lv2:maximum 6 ; lv2:default 0 ; units:unit units:db ], [ a lv2:InputPort, lv2:AudioPort ; lv2:index 4 ; lv2:symbol "in_l" ; lv2:name "Input left" ], [ a lv2:InputPort, lv2:AudioPort ; lv2:index 5 ; lv2:symbol "in_r" ; lv2:name "Input right" ], [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 6 ; lv2:symbol "out_l" ; lv2:name "Output left" ], [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 7 ; lv2:symbol "out_r" ; lv2:name "Output right" ] .
