@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pg: <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
<urn:oxidal:test:group:echo> a pg:Group ; lv2:symbol "echo" ; lv2:name "Echo" .
<urn:oxidal:test:metadata-rich> a lv2:Plugin ; doap:name "Metadata rich fixture" ;
 rdfs:comment """Line one.
Line two	after a tab.""" ; doap:homepage <https://example.org/oxidal/rich> ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "time" ; lv2:name "Delay time" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit units:ms ; pg:group <urn:oxidal:test:group:echo> ; pprops:displayPriority 1 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "ratio" ; lv2:name "Ratio" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit [ a units:Unit ; rdfs:label "points" ; units:render "%f pts" ; units:symbol "pts" ] ; pprops:displayPriority 0 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "low_cut" ; lv2:name "Low cut" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pg:group [ a pg:Group ; lv2:symbol "low" ; lv2:name "Filter" ] ; units:unit units:hz ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "high_cut" ; lv2:name "High cut" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pg:group [ a pg:Group ; lv2:symbol "high" ; lv2:name "Filter" ] ; units:unit units:khz ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "mode" ; lv2:name "Mode" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "Mono" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Stereo" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ] ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "shape" ; lv2:name "Shape" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; lv2:portProperty lv2:integer ; lv2:scalePoint [ rdfs:label "Soft" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Hard" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ] ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "secret" ; lv2:name "Secret" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; lv2:portProperty pprops:notOnGUI ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit units:db ; pprops:displayPriority 2147483647 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit units:pc ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "pitch" ; lv2:name "Pitch" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit units:semitone12TET ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "speed" ; lv2:name "Speed" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit units:bpm ] .

<urn:oxidal:test:metadata-poor> a lv2:Plugin ; doap:name "Metadata poor fixture" ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4  ] .

<urn:oxidal:test:group:one> a pg:Group ; lv2:symbol "one" ; lv2:name "One" .
<urn:oxidal:test:group:two> a pg:Group ; lv2:symbol "two" ; lv2:name "Two" .
<urn:oxidal:test:metadata-ambiguous> a lv2:Plugin ; doap:name "Metadata ambiguous fixture" ;
 doap:homepage <https://example.org/one>, <https://example.org/two> ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "two_units" ; lv2:name "Two units" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit units:ms, units:s ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "two_groups" ; lv2:name "Two groups" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pg:group <urn:oxidal:test:group:one>, <urn:oxidal:test:group:two> ] .

<urn:oxidal:test:group:long-label> a pg:Group ; lv2:symbol "long_label" ; lv2:name "LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL" .
<urn:oxidal:test:metadata-invalid> a lv2:Plugin ; doap:name "Metadata invalid fixture" ;
 rdfs:comment "" ; doap:homepage <javascript:alert(1)> ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "negative_priority" ; lv2:name "Negative" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pprops:displayPriority -1 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "fraction_priority" ; lv2:name "Fraction" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pprops:displayPriority 1.5 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "text_priority" ; lv2:name "Text" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pprops:displayPriority "7" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "huge_priority" ; lv2:name "Huge" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pprops:displayPriority 2147483648 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "long_name" ; lv2:name "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4  ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "long_unit" ; lv2:name "Long unit" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit [ a units:Unit ; units:symbol "uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu" ] ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "line_unit" ; lv2:name "Line unit" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit [ a units:Unit ; units:symbol "a\nb" ] ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "long_unit_uri" ; lv2:name "Long unit address" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit <urn:x:> ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "no_symbol_group" ; lv2:name "Group without symbol" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pg:group [ a pg:Group ; lv2:name "Group without symbol" ] ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "long_label_group" ; lv2:name "Group label too long" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; pg:group <urn:oxidal:test:group:long-label> ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "string_unit" ; lv2:name "Text unit" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; units:unit "dB" ] .

<urn:oxidal:test:metadata-credentials> a lv2:Plugin ; doap:name "Metadata credentials fixture" ;
 doap:homepage <https://user:secret@example.org/> ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ] .

<urn:oxidal:test:metadata-plugin-two> a lv2:Plugin ; doap:name "Metadata text homepage fixture" ;
 doap:homepage "https://example.org/text" ; rdfs:comment <urn:oxidal:test:not-text> ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ] .
