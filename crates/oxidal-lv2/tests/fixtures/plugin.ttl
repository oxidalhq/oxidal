 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "trigger" ; lv2:name "Trigger" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 5 ; lv2:portProperty lv2:integer ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "accepted" ; lv2:name "Accepted" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "rejected" ; lv2:name "Rejected" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "received" ; lv2:name "Received" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "ends" ; lv2:name "Cycles" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:designation lv2:latency ] .

<urn:oxidal:test:atoms> a lv2:Plugin ; doap:name "Atom Sequence contract fixture" ;
 lv2:requiredFeature urid:map ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:InputPort, <http://lv2plug.in/ns/ext/atom#AtomPort> ; lv2:index 2 ; lv2:symbol "events" ; lv2:name "Events" ; <http://lv2plug.in/ns/ext/atom#bufferType> <http://lv2plug.in/ns/ext/atom#Sequence> ; <http://lv2plug.in/ns/ext/resize-port#minimumSize> 8192 ],
 [ a lv2:OutputPort, <http://lv2plug.in/ns/ext/atom#AtomPort> ; lv2:index 3 ; lv2:symbol "notify" ; lv2:name "Notify" ; <http://lv2plug.in/ns/ext/atom#bufferType> <http://lv2plug.in/ns/ext/atom#Sequence> ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Qualification mode" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 8 ; lv2:portProperty lv2:integer ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:designation lv2:latency ] .

