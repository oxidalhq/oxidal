@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
<urn:oxidal:test:unsupported> a lv2:Plugin ; doap:name "Unsupported feature fixture" ; lv2:requiredFeature <urn:oxidal:test:unknown-required-feature> .
<urn:oxidal:test:contract> a lv2:Plugin ; doap:name "Oxidal ABI contract fixture" ;
 lv2:requiredFeature urid:map, urid:unmap, opts:options, bufsz:boundedBlockLength, bufsz:fixedBlockLength, bufsz:powerOf2BlockLength ;
 opts:requiredOption bufsz:minBlockLength, bufsz:maxBlockLength, bufsz:nominalBlockLength ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
 [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 0.9 ] .
<urn:oxidal:test:quantized> a lv2:Plugin ; doap:name "Oxidal ABI contract fixture" ;
 lv2:requiredFeature urid:map, urid:unmap, opts:options, bufsz:boundedBlockLength, bufsz:fixedBlockLength, bufsz:powerOf2BlockLength ;
 opts:requiredOption bufsz:minBlockLength, bufsz:maxBlockLength, bufsz:nominalBlockLength ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
 [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 4 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 0.9 ] .

<urn:oxidal:test:latency> a lv2:Plugin ; doap:name "Latency contract fixture" ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:designation lv2:latency ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "delay" ; lv2:name "Processing delay" ; lv2:default 13 ; lv2:minimum 0 ; lv2:maximum 512 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Qualification mode" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ; lv2:portProperty lv2:integer ] .

<urn:oxidal:test:latency-legacy> a lv2:Plugin ; doap:name "Latency contract fixture" ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:portProperty lv2:reportsLatency ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "delay" ; lv2:name "Processing delay" ; lv2:default 13 ; lv2:minimum 0 ; lv2:maximum 512 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Qualification mode" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ; lv2:portProperty lv2:integer ] .

<urn:oxidal:test:latency-input> a lv2:Plugin ; doap:name "Latency contract fixture" ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
