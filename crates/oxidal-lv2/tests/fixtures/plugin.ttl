 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "delay" ; lv2:name "Processing delay" ; lv2:default 13 ; lv2:minimum 0 ; lv2:maximum 512 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Qualification mode" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ; lv2:portProperty lv2:integer ] .

<urn:oxidal:test:latency-duplicate> a lv2:Plugin ; doap:name "Latency contract fixture" ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:designation lv2:latency ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "delay" ; lv2:name "Processing delay" ; lv2:default 13 ; lv2:minimum 0 ; lv2:maximum 512 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Qualification mode" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ; lv2:portProperty lv2:integer ] , [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "latency2" ; lv2:name "Other latency" ; lv2:designation lv2:latency ] .

<urn:oxidal:test:latency-stereo> a lv2:Plugin ; doap:name "Stereo latency contract fixture" ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
 [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:designation lv2:latency ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "delay" ; lv2:name "Processing delay" ; lv2:default 13 ; lv2:minimum 0 ; lv2:maximum 512 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "mode" ; lv2:name "Qualification mode" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ; lv2:portProperty lv2:integer ] .

<urn:oxidal:test:worker> a lv2:Plugin ; doap:name "Worker ownership contract fixture" ;
 lv2:requiredFeature <http://lv2plug.in/ns/ext/worker#schedule> ;
 lv2:extensionData <http://lv2plug.in/ns/ext/worker#interface> ;
 lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
 [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "trigger" ; lv2:name "Trigger" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 5 ; lv2:portProperty lv2:integer ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "accepted" ; lv2:name "Accepted" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "rejected" ; lv2:name "Rejected" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "received" ; lv2:name "Received" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "ends" ; lv2:name "Cycles" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "latency" ; lv2:name "Latency" ; lv2:designation lv2:latency ] .

<urn:oxidal:test:missing-worker> a lv2:Plugin ; doap:name "Worker ownership contract fixture" ;
 lv2:requiredFeature <http://lv2plug.in/ns/ext/worker#schedule> ;
